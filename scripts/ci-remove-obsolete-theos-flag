#!/usr/bin/env python3
"""Remove only the obsolete multiply_defined suppress linker option."""
import pathlib
import sys

makefiles = pathlib.Path(sys.argv[1]) / "makefiles"
if not makefiles.is_dir():
    raise SystemExit("THEOS/makefiles is missing")
for path in sorted(makefiles.rglob("*.mk")):
    before = path.read_text()
    after = before.replace("-Wl,-multiply_defined,suppress", "")
    after = after.replace("-multiply_defined suppress", "")
    if before != after:
        path.write_text(after)
        print(f"Removed obsolete linker option: {path.relative_to(makefiles)}")
